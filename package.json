    "skill/dbcraft/assets/",
    "skill/testcraft/SKILL.md",
    "skill/testcraft/reference/",
    "skill/testcraft/scripts/",
    "skill/testcraft/assets/",
    "skill/perfcraft/SKILL.md",
    "skill/perfcraft/reference/",
