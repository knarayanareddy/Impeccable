{
  "name": "impeccable-suite",
  "version": "1.0.0",
  "description": "Ten craft skills for AI coding agents \u2014 criterion, codecraft, apicraft, dbcraft, testcraft, perfcraft, seccraft, obscraft, shipcraft, bugcraft \u2014 with a deterministic installer, corpus-integrity gate, and routing evals.",
